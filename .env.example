#############################################
# PROJECT
#############################################

COMPOSE_PROJECT_NAME=woocommerce


#############################################
# DOMAIN
#############################################

DOMAIN=shop.mydomain.com


#############################################
# WORDPRESS / WOOCOMMERCE
#############################################

# VPS localhost port used by Caddy
WORDPRESS_PORT=8080

# WordPress image
WORDPRESS_IMAGE=wordpress:php8.3-apache


#############################################
# MYSQL
#############################################

MYSQL_IMAGE=mysql:8.4

MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress

# CHANGE THESE
MYSQL_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_THIS_TO_A_DIFFERENT_STRONG_PASSWORD


#############################################
# CADDY
#############################################

# Existing host-level Caddy configuration
CADDYFILE=/etc/caddy/Caddyfile

# Directory for generated site configuration
CADDY_SITES_DIR=/etc/caddy/sites-enabled


#############################################
# BACKUPS
#############################################

BACKUP_DIR=/opt/woocommerce-backups

# Number of local backups to keep
BACKUP_RETENTION=7
